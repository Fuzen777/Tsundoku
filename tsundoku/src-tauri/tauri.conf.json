{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tsundoku",
  "mainBinaryName": "Tsundoku",
  "version": "../package.json",
  "identifier": "io.github.fuzen777.tsundoku",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tsundoku",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
