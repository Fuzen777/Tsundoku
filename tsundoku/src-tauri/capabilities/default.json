{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window's UI may call.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "core:window:allow-destroy",
    "updater:default",
    "process:allow-restart"
  ]
}
